# ============================================
# PhishHunter (VSOC-08) — Environment Variables
# ============================================
# Copy this file to .env. Analysis/cases require PostgreSQL and JWT configuration.
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=30
# Explicit opt-in. Missing/failed providers produce UNKNOWN, never synthetic clean output.
CONTENT_BEC_ENABLED=false
VERDICT_LLM_ENABLED=false

# ---- Database ----
# Required for host runtime: postgresql://USER:URL_ENCODED_PASSWORD@localhost:5432/DB
# No production SQLite fallback. Compose supplies the service address automatically.
DATABASE_URL=
# Docker Compose overrides DATABASE_URL with the postgres service address.
POSTGRES_DB=phishhunter
POSTGRES_USER=phishhunter
# Required for Compose: choose a local password using URL-safe characters.
POSTGRES_PASSWORD=

# ---- Authentication ----
# Required: generate a persistent random secret of at least 32 bytes, keep it private.
JWT_SECRET=
JWT_ACCESS_MINUTES=30
JWT_ISSUER=phishhunter
JWT_AUDIENCE=phishhunter-api

# ---- Optional read-only enrichment (disabled by default; no fake production responses) ----
EXTERNAL_ENRICHMENT_ENABLED=false
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_TIMEOUT_SECONDS=5
VIRUSTOTAL_CACHE_TTL_SECONDS=3600
VIRUSTOTAL_MIN_INTERVAL_SECONDS=15
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
URLSCAN_API_KEY=
URLSCAN_ENABLED=false
URLSCAN_TIMEOUT_SECONDS=5
URLSCAN_CACHE_TTL_SECONDS=3600
URLSCAN_MIN_INTERVAL_SECONDS=10
URLSCAN_BASE_URL=https://urlscan.io/api/v1
ENRICHMENT_MAX_URLS=2
ENRICHMENT_MAX_HASHES=2
EXTERNAL_TIMEOUT_SECONDS=5
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=soc_knowledge
# ---- RAG / embedding (explicit opt-in, independent of VT/urlscan/LLM generation) ----
QDRANT_API_KEY=
RAG_ENABLED=false
RAG_DOCUMENTS_PATH=data/rag/documents.jsonl
RAG_CHUNKS_PATH=data/rag/chunks.jsonl
RAG_TOP_K=5
# Provisional cosine threshold; not calibrated. Tune on DEV only in a later task.
RAG_SCORE_THRESHOLD=0.5
# OpenAI-compatible embeddings endpoint base (include /v1 if required by provider).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Explicit embedding model required; MODEL_NAME is for generation, not embedding.
EMBEDDING_MODEL=
# Optional expected output size; empty probes actual provider output.
EMBEDDING_DIMENSION=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
# Qdrant repository/embedding and structured LLM adapters require explicit provisioning.
# Keys alone do not enable Qdrant/LLM. No feed ingestion, uploads or URL submissions.

# ---- App Config ----
APP_ENV=development
APP_NAME=PhishHunter
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
# Comma-separated receiving mail server IDs. Empty means reported auth is UNKNOWN.
# Only configure receivers whose trusted export strips sender-forged auth headers.
HEADER_TRUSTED_AUTHSERV_IDS=
# Optional comma-separated domains for local typo/confusable comparison; no network lookup.
URL_PROTECTED_DOMAINS=
# Local exact-match IOC snapshot. Build explicitly: python -m scripts.build_ioc_index
# Relative paths resolve from the project root; index must remain outside data/.
IOC_DATA_PATH=data/ioc/ioc_normalized.jsonl
IOC_INDEX_PATH=runtime/ioc.sqlite3

# ---- Logging ----
LOG_LEVEL=INFO
# Metadata-only node/request traces; disabled/missing keys never block analysis.
# Supports Langfuse OTLP HTTP/JSON; no raw email, prompts, headers or indicators exported.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TIMEOUT_SECONDS=2

# ---- Frontend (if separate) ----
# Next.js reads frontend/.env.local; copy frontend/.env.example there explicitly.
# This public value is compiled at frontend build time, not read from backend settings.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
